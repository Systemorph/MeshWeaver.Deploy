# Worktrees (AGENTS.md "Work in worktrees")
.worktrees/

# Claude Code per-user local state — but DO track shared skills under .claude/skills/.
.claude/*
!.claude/skills/

# .NET build output — scoped to the one .NET tree here, never bare (a bare [Dd]ebug/ rule would
# swallow a directory of that name anywhere, and git never reports what it never descends into).
test/**/bin/
test/**/obj/
TestResults/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# A real `.env` is deployment configuration — hosts, database names, keys. The generated
# `.env.example` beside each compose file is tracked; the filled-in `.env` beside it never is
# (deploy/GENERATED-TARGETS.md).
.env
# The compose topology's bind-mounted runtime data.
deploy/compose/data/
deploy/compose-ha/data/

# The Whisper voice model is a DOWNLOAD, never a tracked file — GitHub rejects any blob over 100 MB.
# The context build (MODEL_SOURCE=context, deploy/whisper/Dockerfile) reads it from this untracked
# directory; deploy/whisper/README.md says how to fetch it.
deploy/whisper/models/

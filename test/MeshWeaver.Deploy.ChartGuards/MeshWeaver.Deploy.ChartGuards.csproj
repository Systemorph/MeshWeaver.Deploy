<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The guards that hold this chart to the platform's code: probe paths against ProbeEndpoints, the
    drain deadline against ServiceDefaults, ConfigMap keys against their readers, the migration Job
    model, the Modules__Required__N ceiling against the record contract, and the rest. They moved
    out of the platform's test projects (and briefly through MeshWeaver.Plugins) with the chart.
    Chart files resolve against THIS repository; platform files against $(MeshWeaverRoot).
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- ProbeSeparationTest, RollGateReadinessOnlyTest, RollMidSessionDrainTest drive the platform's
         REAL probe and drain composition on the paths the chart ships. The setup-only host's probe
         guard (SetupProbeEndpointsTest) is NOT here: Memex.Portal.Shared left the public platform
         for MeshWeaver.Plugins (MeshWeaver#7125), so its guard lives beside it there. -->
    <ProjectReference Include="$(MeshWeaverRoot)/memex/aspire/Memex.Portal.ServiceDefaults/Memex.Portal.ServiceDefaults.csproj" />
    <ProjectReference Include="$(MeshWeaverRoot)/src/MeshWeaver.Hosting/MeshWeaver.Hosting.csproj" />
    <ProjectReference Include="$(MeshWeaverRoot)/src/MeshWeaver.Mesh.Contract/MeshWeaver.Mesh.Contract.csproj" />
    <ProjectReference Include="$(MeshWeaverRoot)/src/MeshWeaver.Deployment.Contract/MeshWeaver.Deployment.Contract.csproj" />
    <!-- AutomationSwitchesReachTheConfigMapGuard and its two siblings parse `helm template`'s output
         with the platform's YAML reader (Doc/Architecture/TolerantYaml), as the platform's own
         guards do: no platform code uses YamlDotNet any more. -->
    <ProjectReference Include="$(MeshWeaverRoot)/src/MeshWeaver.Yaml/MeshWeaver.Yaml.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>
  <ItemGroup>
    <!-- ChartRoots.PlatformRoot resolves the platform checkout at RUN time through this. -->
    <AssemblyMetadata Include="MeshWeaverRoot" Value="$([System.IO.Path]::GetFullPath('$(MeshWeaverRoot)'))" />
  </ItemGroup>
</Project>

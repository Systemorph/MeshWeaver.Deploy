<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The guards that hold this chart to the platform's code: probe paths against ProbeEndpoints, the
    drain deadline against ServiceDefaults, ConfigMap keys against their readers, the migration Job
    model, the Modules__Required__N ceiling against the record contract (the Deployment record, which
    lives in MeshWeaver.Plugins), and the rest. They moved
    out of the platform's test projects (and briefly through MeshWeaver.Plugins) with the chart.
    Chart files resolve against THIS repository; platform files against $(MeshWeaverRoot); the portal
    hosts' service defaults (which left the platform, MeshWeaver#7297) against $(MeshWeaverPluginsRoot).
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- ProbeSeparationTest, RollGateReadinessOnlyTest, RollMidSessionDrainTest drive the platform's
         REAL probe and drain composition on the paths the chart ships. The setup-only host's probe
         guard (SetupProbeEndpointsTest) is NOT here: Memex.Portal.Shared left the public platform
         for MeshWeaver.Plugins (MeshWeaver#7125), so its guard lives beside it there.
         Memex.Portal.ServiceDefaults followed it (MeshWeaver#7297, MeshWeaver.Plugins#4333). -->
    <ProjectReference Include="$(MeshWeaverPluginsRoot)/src/Memex.Portal.ServiceDefaults/Memex.Portal.ServiceDefaults.csproj" />
    <ProjectReference Include="$(MeshWeaverRoot)/src/MeshWeaver.Hosting/MeshWeaver.Hosting.csproj" />
    <ProjectReference Include="$(MeshWeaverRoot)/src/MeshWeaver.Mesh.Contract/MeshWeaver.Mesh.Contract.csproj" />
    <!-- The Deployment record (namespace MeshWeaver.Hosting.Deployment). It left the platform for the
         Hosting package's module in MeshWeaver.Plugins; this is the dependency-free copy of it that the
         Aspire package bundles — the module itself would bring its whole closure into this suite. -->
    <ProjectReference Include="$(MeshWeaverPluginsRoot)/src/MeshWeaver.Hosting.Deployment.Contract/MeshWeaver.Hosting.Deployment.Contract.csproj" />
    <!-- AutomationSwitchesReachTheConfigMapGuard and its two siblings parse `helm template`'s output
         with the platform's YAML reader (Doc/Architecture/TolerantYaml), as the platform's own
         guards do: no platform code uses YamlDotNet any more. -->
    <ProjectReference Include="$(MeshWeaverRoot)/src/MeshWeaver.Yaml/MeshWeaver.Yaml.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>
  <ItemGroup>
    <!-- ChartRoots.PlatformRoot resolves the platform checkout at RUN time through this. -->
    <AssemblyMetadata Include="MeshWeaverRoot" Value="$([System.IO.Path]::GetFullPath('$(MeshWeaverRoot)'))" />
    <!-- ChartRoots.PluginsRoot resolves the MeshWeaver.Plugins checkout the same way. -->
    <AssemblyMetadata Include="MeshWeaverPluginsRoot" Value="$([System.IO.Path]::GetFullPath('$(MeshWeaverPluginsRoot)'))" />
  </ItemGroup>
</Project>

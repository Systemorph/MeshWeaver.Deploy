<Project>
  <!--
    Build settings for the chart guards. They compile against the PLATFORM as project references
    (the probe wiring, ServiceDefaults, the record contract), because what they assert is that this
    chart agrees with the platform's code — so $(MeshWeaverRoot) names a Systemorph/MeshWeaver
    checkout. Default: a SIBLING checkout (../MeshWeaver beside this repository); CI checks the
    platform out at a DECLARED ref and passes -p:MeshWeaverRoot=….

    $(MeshWeaverPluginsRoot) names a Systemorph/MeshWeaver.Plugins checkout: the portal hosts'
    service defaults (the probe and drain wiring the chart has to agree with) left the platform for
    MeshWeaver.Plugins (MeshWeaver#7297, MeshWeaver.Plugins#4333). Default: a SIBLING checkout
    (../MeshWeaver.Plugins); CI checks it out at a DECLARED ref and passes -p:MeshWeaverPluginsRoot=….

    The test infrastructure (xunit v3 on Microsoft.Testing.Platform, the shared xunit.runner.json
    with its methodTimeout, the assertion helpers) is the platform's, imported, never copied: a
    second copy here would drift from the one every other suite in the fleet runs under.
  -->
  <PropertyGroup>
    <MeshWeaverRoot Condition="'$(MeshWeaverRoot)' == ''">$(MSBuildThisFileDirectory)../../MeshWeaver</MeshWeaverRoot>
    <MeshWeaverPluginsRoot Condition="'$(MeshWeaverPluginsRoot)' == ''">$(MSBuildThisFileDirectory)../../MeshWeaver.Plugins</MeshWeaverPluginsRoot>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability ADVISORIES stay warnings, exactly as in the platform's props: they are a
         fact about the outside world that changes with no commit here. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>
    <IsPackable>false</IsPackable>
    <!-- The platform runs every executable with Tiered PGO off (MeshWeaver#890); a test host that
         drives the platform's composition does too. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <Import Project="$(MeshWeaverRoot)/test/Directory.Build.props" />
</Project>

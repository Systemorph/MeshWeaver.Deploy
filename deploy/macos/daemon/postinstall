#!/bin/bash
# postinstall — the OPTIONAL "Unattended host" component of the Memex .pkg (deploy/macos/README.md §1d).
# The payload put the LaunchDaemon template at /Library/LaunchDaemons/com.memex.local.daemon.plist and
# the daemon script under /opt/memex/libexec. This script:
#   1. picks the SERVICE USER — the managed preference com.memex.local ServiceUser (an MDM pre-fills it
#      for a fleet), else the console user Installer is serving — and writes it into the plist;
#   2. creates /var/log/memex for the daemon's log, owned by that user;
#   3. bootstraps the daemon ONLY when the managed preference Unattended is true. Otherwise it is
#      installed and left unloaded, and the one command that loads it is printed — a daemon that starts a
#      VM at every boot is armed by a declaration, never by the mere act of installing.
# Idempotent: a re-run rewrites the same plist and re-bootstraps (bootout first) or leaves it unloaded.
set -uo pipefail
plist="${MEMEX_PKG_DAEMON_PLIST:-/Library/LaunchDaemons/com.memex.local.daemon.plist}"
logdir="${MEMEX_PKG_DAEMON_LOGDIR:-/var/log/memex}"
pref() { defaults read "/Library/Managed Preferences/com.memex.local" "$1" 2>/dev/null || defaults read com.memex.local "$1" 2>/dev/null || true; }

label="system/com.memex.local.daemon"
user="$(pref ServiceUser)"
[ -n "$user" ] || user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
case "$user" in ""|root|loginwindow|_*)
  # No user to run as — and possibly a job from an EARLIER enabled install still running: stop it and
  # persist the disabled state before leaving, so the previous configuration cannot outlive this one.
  launchctl bootout system "$plist" >/dev/null 2>&1 || true
  launchctl disable "$label" >/dev/null 2>&1 || true
  echo "daemon postinstall: no service user — set the managed preference com.memex.local ServiceUser (or install from a logged-in session); any earlier daemon was booted out and disabled, and the plist keeps __USER__ ($plist)" >&2
  exit 0 ;;
esac
# Render __USER__ (a re-run finds the previous user's name instead of the token: replace either).
prev="$(/usr/libexec/PlistBuddy -c 'Print :UserName' "$plist" 2>/dev/null || true)"
/usr/libexec/PlistBuddy -c "Set :UserName $user" "$plist" >/dev/null 2>&1 || sed -i '' "s|__USER__|$user|g" "$plist"
plutil -lint "$plist" >/dev/null || { echo "daemon postinstall: $plist is not a valid plist after substitution" >&2; exit 1; }
echo "daemon postinstall: service user $user${prev:+ (was $prev)}"

mkdir -p "$logdir" && chown "$user" "$logdir" 2>/dev/null || true

# The plist carries RunAtLoad + KeepAlive, so a file in /Library/LaunchDaemons would start at the next
# boot by itself. The preference therefore drives launchd's PERSISTED enable/disable state, both ways:
# not true → bootout whatever an earlier Unattended=true install loaded AND `launchctl disable` (survives
# reboots; the plist stays installed, inert, until someone enables it); true → enable + bootstrap.
unattended="$(pref Unattended)"
case "$unattended" in 1|true|TRUE|yes|YES)
  launchctl bootout system "$plist" >/dev/null 2>&1 || true     # an absent old job is fine
  # The REQUESTED operations must succeed, or Installer and the MDM must hear that unattended startup
  # did not happen: a non-zero exit here fails the install.
  launchctl enable "$label" || { echo "daemon postinstall: launchctl enable $label FAILED — unattended startup is NOT armed" >&2; exit 1; }
  launchctl bootstrap system "$plist" || { echo "daemon postinstall: launchctl bootstrap system $plist FAILED — unattended startup is NOT armed" >&2; exit 1; }
  echo "daemon postinstall: com.memex.local.daemon enabled + bootstrapped (Unattended=true); log: $logdir/daemon.log" ;;
*)
  launchctl bootout system "$plist" >/dev/null 2>&1 || true
  launchctl disable "$label" >/dev/null 2>&1 || true
  echo "daemon postinstall: installed, DISABLED and not loaded (managed preference Unattended is not true — it will not start at boot). Enable it with:"
  echo "  sudo launchctl enable $label && sudo launchctl bootstrap system $plist" ;;
esac
exit 0

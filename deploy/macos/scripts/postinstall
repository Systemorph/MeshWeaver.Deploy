#!/bin/bash
# postinstall — the memex-local component of the Memex .pkg, run by Installer as root once the payload
# is on disk (deploy/macos/README.md §1a, §2). Idempotent: a re-run of the installer, or the menu-bar
# app's Update, repairs only what is missing and reports "unchanged" otherwise.
#
# "It will see what's there and install whatever is missing" (maintainer, 2026-10-26). The payload lays
# every vendored tool down INERT under <prefix>/libexec/vendor/<tool>/; this script PROBES the machine
# through the same resolver the CLI uses (share/tools.sh over share/tools.manifest) and ACTIVATES a
# vendored copy — a symlink <prefix>/bin/<tool> — only for a tool that is missing or below its floor.
# An existing installation that meets the floor (the developer's Homebrew copy, a hand install) is
# used as is: never overwritten, never shadowed, and nothing is ever written into Homebrew's prefix.
# A fallback activated earlier is REMOVED when a satisfying installation has since appeared, so the
# user's copy takes over on the next run — the precedence list is the same in both directions.
#
# Installer runs scripts with a minimal environment; the probe PATH is set explicitly below and covers
# both Homebrew prefixes. The two MEMEX_PKG_* variables exist for the test suite (deploy/macos/test):
# Installer never sets them, so the defaults are what a real install uses.
set -uo pipefail
PREFIX="${MEMEX_PKG_PREFIX:-/opt/memex}"
export PATH="${MEMEX_PKG_PROBE_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin}"
export MEMEX_PREFIX="$PREFIX"
# shellcheck source=../../homebrew/share/tools.sh
. "$PREFIX/share/tools.sh" || { echo "postinstall: $PREFIX/share/tools.sh is not in the payload" >&2; exit 1; }

mkdir -p "$PREFIX/etc" "$PREFIX/bin"
report="$PREFIX/etc/tools.report"
changed=0
lines=""
say() { printf '%s\n' "$*"; lines="${lines}${1}"$'\n'; }

# `brew list --versions <formula>` for the report — informational, and only when brew exists. brew
# refuses to run as root, so it runs as the console user Installer is serving.
brew_bin="$(command -v brew 2>/dev/null || true)"   # on the probe PATH above (both Homebrew prefixes)
console_user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
brew_version() {
  [ -n "$brew_bin" ] || return 0
  if [ "$(id -u)" -eq 0 ] && [ -n "$console_user" ] && [ "$console_user" != "root" ]; then
    sudo -u "$console_user" -H "$brew_bin" list --versions "$1" 2>/dev/null | head -1
  else
    "$brew_bin" list --versions "$1" 2>/dev/null | head -1
  fi
  return 0
}

say "memex-local postinstall — toolchain probe ($(date -u +%Y-%m-%dT%H:%M:%SZ), prefix $PREFIX, manifest $TOOLS_MANIFEST)"
say "existing installation first (floor met), vendored copy second, never into Homebrew's prefix"
for name in $(tools_list); do
  line="$(tool_resolve "$name" || true)"
  IFS=$'\t' read -r name kind path version floor verdict note <<<"$line"
  bin="$(tool_field "$name" 2)"; bin="${bin%%:*}"
  link="$PREFIX/bin/$bin"
  action=""
  case "$kind:$verdict" in
    vendored:ok)
      if [ "$(readlink "$link" 2>/dev/null || true)" = "$path" ]; then
        action="kept the vendored fallback"
      else
        rm -f "$link"; ln -s "$path" "$link"; changed=$((changed + 1))
        action="ACTIVATED the vendored fallback → $link"
      fi ;;
    existing:ok)
      if [ -L "$link" ]; then
        rm -f "$link"; changed=$((changed + 1))
        action="removed the stale fallback $link — the existing installation now meets the floor"
      else
        action="using the existing installation"
      fi ;;
    *)
      if [ -L "$link" ]; then rm -f "$link"; changed=$((changed + 1)); action="removed $link (its target no longer resolves); "; fi
      action="${action}NOT RESOLVED — nothing vendored for it; install it ($(tool_field "$name" 3))" ;;
  esac
  bv="$(brew_version "$(tool_field "$name" 3)")"
  say "  $(printf '%-13s %-9s %-9s floor %-7s %-12s %s%s%s' "$name" "$kind" "$version" "$floor" "$verdict" "$path" "${bv:+  [brew: $bv]}" "${note:+  ($note)}")"
  say "  $(printf '%-13s → %s' "" "$action")"
done
say "changed: $changed"
printf '%s' "$lines" > "$report"
chmod 644 "$report"
say "report: $report"
exit 0

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements build-pkg.sh signs the vendored limactl with (deploy/macos/README.md §1a "Signing").
  Lima drives the Virtualization framework (vmType vz), which a hardened-runtime binary may use only
  with com.apple.security.virtualization — Lima's own release binaries are ad-hoc signed with exactly
  this entitlement, and notarization requires us to re-sign every vendored Mach-O with our Developer ID.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.virtualization</key>
    <true/>
</dict>
</plist>

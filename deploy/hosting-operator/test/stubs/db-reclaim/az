#!/usr/bin/env bash
# A stand-in `az` for hosting-db-reclaim's tests: the server's admin password BY NAME
# (hosting::pg_password), the Flexible Server listing (its id and provisioned GiB) and its
# storage_used metric. Records every argv in $HOSTING_DBRC_STATE/az.log. Files:
#   server          `<resource id>\t<storageSizeGb>` (absent: the server is not visible)
#   server-refused  present: the listing answers AuthorizationFailed
#   used            the storage_used metric's newest maximum, in bytes (absent: no datapoint)
set -uo pipefail
state="${HOSTING_DBRC_STATE:?the az stub needs HOSTING_DBRC_STATE}"
printf 'az %s\n' "$*" >> "$state/az.log"
case "${1:-} ${2:-} ${3:-}" in
  "keyvault secret show")
    name=""
    while [ $# -gt 0 ]; do case "$1" in --name) name="${2:-}"; shift 2 ;; *) shift ;; esac; done
    [ "$name" = "memex-postgres-password" ] && { echo "fake-server-password-NEVER-PRINTED"; exit 0; }
    echo "ERROR: (SecretNotFound) A secret with (name/id) ${name} was not found in this key vault." >&2; exit 3 ;;
  "postgres flexible-server list")
    [ -e "$state/server-refused" ] && { echo "ERROR: (AuthorizationFailed) The client does not have authorization to perform action 'Microsoft.DBforPostgreSQL/flexibleServers/read'." >&2; exit 1; }
    [ -f "$state/server" ] && cat "$state/server"
    exit 0 ;;
  "monitor metrics list")
    [ -f "$state/used" ] && cat "$state/used"
    exit 0 ;;
esac
echo "az stub: unexpected invocation: $*" >&2
exit 1

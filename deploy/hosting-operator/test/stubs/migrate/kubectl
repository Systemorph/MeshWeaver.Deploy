#!/usr/bin/env bash
# A stand-in `kubectl` for hosting-migrate's tests. Records every invocation (and the body of every
# `create -f -`) in $HOSTING_MIGRATE_STUB_LOG / $FIXTURE/created.json. The Job's life is played from
# files in $HOSTING_MIGRATE_FIXTURE:
#   rendered.json   what `create --dry-run=client -o json -f -` answers (kubectl's own YAML parsing is
#                   not under test — the manifest's text is ignored)
#   job-state       absent | succeeded | failed | active | forbidden   (the Job as `get job` sees it)
#   outcome         what a CREATED Job becomes after `polls` more reads: succeeded | failed | hang
#   polls           how many reads a created Job stays active before it reaches its outcome
# and, for the description of a FAILED Job (MeshWeaver.Deploy#315):
#   failed-job.json what `get job` answers once the Job has failed (default: a bare Failed condition)
#   job-log         "unreadable" plays the estate's answer to `logs job/<job>`: kubectl's pod-selection
#                   notice on stderr and a non-zero exit, nothing on stdout
#   pods.json       what `get pods -l <selector>` answers (default: no pods); pods-label, when present,
#                   names the ONE selector key the pods answer to (the other gets no pods)
#   events.json     what `get events` answers (default: none)
#   pod-log, pod-log-previous   what `logs <pod>` / `logs <pod> --previous` answer (default: an error)
set -uo pipefail
log="${HOSTING_MIGRATE_STUB_LOG:?the kubectl stub needs HOSTING_MIGRATE_STUB_LOG}"
fixture="${HOSTING_MIGRATE_FIXTURE:?the kubectl stub needs HOSTING_MIGRATE_FIXTURE}"
printf 'kubectl %s\n' "$*" >> "$log"
if [ "${1:-}" = "-n" ]; then shift 2; fi
state() { cat "$fixture/job-state" 2>/dev/null || echo absent; }
job_json() {
  case "$1" in
    succeeded) echo '{"kind":"Job","status":{"succeeded":1}}' ;;
    failed)
      if [ -f "$fixture/failed-job.json" ]; then cat "$fixture/failed-job.json"
      else echo '{"kind":"Job","status":{"failed":7,"conditions":[{"type":"Failed","status":"True"}]}}'; fi ;;
    *)         echo '{"kind":"Job","status":{"active":1}}' ;;
  esac
}
case "${1:-}" in
  create)
    if [ "${2:-}" = "--dry-run=client" ]; then cat >/dev/null; cat "$fixture/rendered.json"; exit 0; fi
    cat > "$fixture/created.json"
    echo active > "$fixture/job-state"
    echo "job.batch/created" ;;
  get)
    if [ "${2:-}" = "pods" ] || [ "${2:-}" = "events" ]; then
      # "forbidden" in pods.json / events.json plays a refused list.
      [ "$(cat "$fixture/${2}.json" 2>/dev/null || true)" = "forbidden" ] \
        && { echo "Error from server (Forbidden): ${2} is forbidden: User cannot list resource" >&2; exit 1; }
    fi
    if [ "${2:-}" = "pods" ]; then
      # `get pods -l <key>=<job> -o json`
      sel="${4:-}"; want="$(cat "$fixture/pods-label" 2>/dev/null || true)"
      if [ -f "$fixture/pods.json" ] && { [ -z "$want" ] || [ "${sel%%=*}" = "$want" ]; }; then cat "$fixture/pods.json"
      else echo '{"kind":"List","items":[]}'; fi
      exit 0
    fi
    if [ "${2:-}" = "events" ]; then
      if [ -f "$fixture/events.json" ]; then cat "$fixture/events.json"; else echo '{"kind":"List","items":[]}'; fi
      exit 0
    fi
    if [ "${2:-}" = "deployment" ] && [[ "$*" == *"containers[0].image"* ]]; then
      # `get deployment memex-portal-deployment -o jsonpath=…containers[0].image` (--current's tag
      # read): $FIXTURE/portal-image, else NotFound; "forbidden" in it plays a refused read.
      i="$(cat "$fixture/portal-image" 2>/dev/null || true)"
      [ "$i" = "forbidden" ] && { echo "Error from server (Forbidden): deployments.apps is forbidden" >&2; exit 1; }
      [ -n "$i" ] || { echo "Error from server (NotFound): deployments.apps \"memex-portal-deployment\" not found" >&2; exit 1; }
      printf '%s' "$i"; exit 0
    fi
    if [ "${2:-}" = "deployment" ]; then
      # `get deployment memex-portal-deployment -o jsonpath=…release-name` (the --tag form's release
      # read): $FIXTURE/release-name, else NotFound; "forbidden" in it plays a refused read.
      r="$(cat "$fixture/release-name" 2>/dev/null || true)"
      [ "$r" = "forbidden" ] && { echo "Error from server (Forbidden): deployments.apps is forbidden" >&2; exit 1; }
      [ -n "$r" ] || { echo "Error from server (NotFound): deployments.apps \"memex-portal-deployment\" not found" >&2; exit 1; }
      printf '%s' "$r"; exit 0
    fi
    s="$(state)"
    case "$s" in
      absent)    echo "Error from server (NotFound): jobs.batch \"${3:-}\" not found" >&2; exit 1 ;;
      forbidden) echo "Error from server (Forbidden): jobs.batch \"${3:-}\" is forbidden: User cannot get resource" >&2; exit 1 ;;
      active)
        n="$(cat "$fixture/polls" 2>/dev/null || echo 0)"
        if [ "$n" -gt 0 ]; then echo $((n - 1)) > "$fixture/polls"; job_json active; exit 0; fi
        o="$(cat "$fixture/outcome" 2>/dev/null || echo succeeded)"
        [ "$o" = "hang" ] && { job_json active; exit 0; }
        echo "$o" > "$fixture/job-state"; job_json "$o" ;;
      *) job_json "$s" ;;
    esac ;;
  delete) echo absent > "$fixture/job-state"; echo "job.batch deleted" ;;
  logs)
    if [[ "${2:-}" == job/* ]]; then
      if [ "$(cat "$fixture/job-log" 2>/dev/null || true)" = "unreadable" ]; then
        echo "Found 7 pods, using pod/${2#job/}-m4ph4" >&2; exit 1
      fi
      printf 'Rehearsal: 2 pending migrations\nDatabase migration completed. Version: 57\n'; exit 0
    fi
    # `logs <pod> --all-containers [--previous] --tail=N`
    if [[ "$*" == *--previous* ]]; then f="$fixture/pod-log-previous"; else f="$fixture/pod-log"; fi
    [ -f "$f" ] || { echo "Error from server (BadRequest): container \"memex-migration\" in pod \"${2:-}\" is not available" >&2; exit 1; }
    cat "$f" ;;
  *) echo "kubectl stub: unexpected invocation: $*" >&2; exit 1 ;;
esac

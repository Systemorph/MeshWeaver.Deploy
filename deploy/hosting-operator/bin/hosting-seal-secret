#!/usr/bin/env bash
# hosting-seal-secret --vault <vault> --object <object> --seal-to <base64 SPKI of an RSA-3072+ key> --item <x>
#
# SEAL an EXISTING vault object to an enrolling Mac's throw-away public key, inside this job, and emit
# ONLY its ciphertext (Hosting/MacStudioFleet §2b, enrolment v2 — CONTRACT §4): the DNS-01 identity's
# client secret (`n`), the fleet local-CA private key (`a`) and, on a build-queue opt-in, the build
# worker token, pull password and read-only registry key (`w`, `p`, `k`). The enrolment code carries
# each item sealed separately (RSA-OAEP-SHA256 with MGF1-SHA256, ONE block), so the Mac opens it with
# its throw-away private key and nothing else ever holds the value in clear.
#
#   1. the recipient key is checked first: RSA, 3072–8192 bits (nothing is read from the vault otherwise)
#   2. the object is read into a mode-600 file (`az keyvault secret show … --query value`, through a
#      file — never a variable, never an argument list). The ONE newline `-o tsv` appends is cut, file to file.
#   3. a value larger than one OAEP block (modulus bytes − 66: 318 for RSA-3072) is REFUSED, naming
#      its size — it is never split, never truncated
#   4. `::hosting:: sealed_item item=<x> fp=<sha256:12hex|withheld:low-entropy> b64=<ciphertext>`
#
# 🚨 NEVER PRINTS THE VALUE (policy `secrets-write-only-entry`): what crosses back is ciphertext only
# the Mac can open and the same fingerprint a vault tag would carry. Nothing is WRITTEN anywhere.
# A dry run checks the key and that the object exists (from the LISTING — no value read) and stops.
# shellcheck source=_common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-seal-secret"

vault="" object="" seal_to="" item=""
# A flag given LAST with no value must not spin (see hosting-registry-coupon).
shift_value() { if [ $# -ge 2 ]; then shift_n=2; else shift_n=1; fi; }
while [ $# -gt 0 ]; do
  shift_n=1
  case "$1" in
    --vault)   vault="${2:-}";   shift_value "$@" ;;
    --object)  object="${2:-}";  shift_value "$@" ;;
    --seal-to) seal_to="${2:-}"; shift_value "$@" ;;
    --item)    item="${2:-}";    shift_value "$@" ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
  shift "$shift_n"
done
hosting::need_flag vault "$vault"
hosting::need_flag object "$object"
hosting::need_flag seal-to "$seal_to"
hosting::need_flag item "$item"
hosting::safe_name vault "$vault"
hosting::safe_name object "$object"
hosting::safe_item "$item"

umask 077
work="$(mktemp -d)" || hosting::die "could not create a private working directory. Nothing was read."
trap 'hosting::on_exit; rm -rf "$work"' EXIT
hosting::seal_key "$seal_to" "$work"
hosting::log "seal-to   RSA-${HOSTING_SEAL_BITS} public key, sha256 $(hosting::sha256 < "$work/seal.der" | cut -c1-12)… (item ${item})"

hosting::step "Find ${object} in vault ${vault}"
hosting::kv_exists "$vault" "$object"; rc=$?
case "$rc" in
  0) ;;
  2) hosting::die "could not LIST vault ${vault} — REFUSED or unreachable, so whether ${object} exists is UNKNOWN. The identity needs \`list\` on ${vault}. Nothing was read." ;;
  *) hosting::die "vault ${vault} holds no object ${object} — there is nothing to seal. Nothing was read." ;;
esac

if hosting::dry; then
  hosting::log "(dry run) would read ${object} from vault ${vault} into a private file and seal it as item ${item} (never shown)"
  hosting::say sealed_secret dry-run
  exit 0
fi

hosting::step "Seal ${object} to the enrolling machine"
if ! az keyvault secret show --vault-name "$vault" --name "$object" --query value -o tsv > "$work/value" 2>/dev/null; then
  hosting::die "could not read ${object} from vault ${vault} — the operator identity needs secret GET on it. Nothing was sealed."
fi
# `-o tsv` ends the value with ONE newline that is not part of it: exactly that one byte is cut, file to file
# (a PEM value keeps its own trailing newline, and the value never passes through an argument list).
size="$(LC_ALL=C wc -c < "$work/value" | tr -d ' ')"
if [ "$size" -gt 0 ] && [ "$(tail -c1 "$work/value" | LC_ALL=C wc -l | tr -d ' ')" = "1" ]; then
  head -c "$((size - 1))" "$work/value" > "$work/value.cut" && mv "$work/value.cut" "$work/value"
  size=$((size - 1))
fi
[ "$size" -gt 0 ] || hosting::die "vault ${vault} object ${object} is EMPTY — refusing to seal nothing as item ${item}"
[ "$size" -le "$HOSTING_SEAL_LIMIT" ] \
  || hosting::die "${object} is ${size} bytes — one RSA-${HOSTING_SEAL_BITS} OAEP-SHA256 block holds at most ${HOSTING_SEAL_LIMIT}; it is never split or cut. Nothing was sealed."
hosting::seal_item "$item" "$work/value" "$work" \
  || hosting::die "${object} could not be sealed: ${HOSTING_SEAL_ERR}. Nothing was sealed."
rm -f "$work/value"
hosting::log "sealed    ${object} from vault ${vault} as item ${item} (${size} bytes; never shown)"
hosting::say sealed_secret "${item}:${object}"

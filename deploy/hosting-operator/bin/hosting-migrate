#!/usr/bin/env bash
# hosting-migrate --namespace <ns> --release <release> --image <registry>/<path>/memex-migration:<tag>
# hosting-migrate --namespace <ns> [--release <release>] --tag <tag>
# hosting-migrate --namespace <ns> [--release <release>] --current --fresh
#
# The third form is the database RESET's (MeshWeaver.Plugins#2781, policy
# `reset-database-keeps-a-copy`): `--current` migrates the tag the portal Deployment RUNS (read off
# its own image, never typed), and `--fresh` says the database this tag's Job migrated was replaced
# by an empty one — so a Job that already SUCCEEDED for the tag is deleted and run again instead of
# being reported. Without `--fresh` a succeeded Job is still never re-run.
#
# The second form is the one run.sh's interlock uses (policy `roll-migrates-first`): it knows only the
# namespace and the TARGET TAG the plan's `set image` moves to. The release is then read off the portal
# Deployment's own `meta.helm.sh/release-name` annotation, and the migration image is the release's own
# migration Job image with only its tag moved — so the interlock needs nothing the plan did not say.
#
# Run the database migration for a TARGET image as its own run-once Job, OUTSIDE the portal, and
# wait for it to finish — the step a Roll runs BEFORE it moves the portal image. The rule
# (maintainer, 2026-09-21; Systemorph/Memex docs/delivery-model.md): a schema change ships as a new
# image, and every path that moves the image runs that tag's migration first, as a separate Job.
#
# 🚨 WHY THIS EXISTS. A Roll was `kubectl set image` and nothing else. A target that expects a newer
# db_version then dies on DbVersionGate ~3 s after start, behind old pods that keep answering 200 —
# measured on memex-cloud 2026-09-19 rolling 3.0.0-ci.8411 → 8955: CrashLoopBackOff, no migration
# Job in the namespace, and a record that said the roll was made. helm renders its migration Job
# only on `helm upgrade` (`memex-migration-<revision>`) and the in-pod self-updater mints its own
# (`memex-migration-su-<tag>`); the control lane's Roll — the routine path for every instance that
# reports to a control instance — had neither (Doc/Architecture/SelfUpdateSchemaWall, option b1).
#
# THE JOB IS THE RELEASE'S OWN. It is read from `helm get manifest` — the migration Job the chart
# rendered for this release, with its wait-for-postgres gate, its rehearsal init container, its
# budget (activeDeadlineSeconds), its envFrom (memex-migration-config / -secrets and any Key Vault
# synced Secret) and its pull Secret — and ONLY the image of the containers that run the migration
# image is moved to --image. Nothing is re-derived here, so a chart change to how the migration runs
# reaches this step without an edit. A release that renders no migration Job is a REFUSAL: a roll
# that cannot migrate must not move the image.
#
# IDEMPOTENT per tag. The Job is `memex-migration-roll-<tag>`: succeeded → reported, not re-run;
# failed → deleted and run again (a retried roll must not read the last failure as its verdict);
# still running → waited on.
#
# Output contract (the ::hosting:: lines the mesh reads):
#   migration_job=<name>     the Job this run created or found
#   migration=completed      the Job reported succeeded ≥ 1 — the ONLY success
# A failed Job, a vanished Job or one still running past its own budget exits non-zero, naming the
# Job. A failed or overdue one is also DESCRIBED (failure_report, MeshWeaver.Deploy#315): the cause on
# the ERROR line itself (the Job's Failed condition + the newest failed pod's failing container), then
# its pods' states, their last events and the newest failed pod's own log — bounded, from `.status`,
# events and logs only.

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-migrate"

namespace="" release="" image="" tag="" current=0 fresh=0
interval="${HOSTING_MIGRATE_INTERVAL:-5}" grace="${HOSTING_MIGRATE_GRACE:-120}"
while [ $# -gt 0 ]; do
  case "$1" in
    --namespace) namespace="${2:-}"; shift 2 ;;
    --release)   release="${2:-}";   shift 2 ;;
    --image)     image="${2:-}";     shift 2 ;;
    --tag)       tag="${2:-}";       shift 2 ;;
    --current)   current=1;          shift ;;
    --fresh)     fresh=1;            shift ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
done

hosting::need_flag namespace "$namespace"
hosting::safe_name namespace "$namespace"
# --current: the tag is the one the portal RUNS, read off its own Deployment — three answers, and
# neither a refusal nor an absence may pick a tag for it.
if [ "$current" = 1 ]; then
  [ -z "$image" ] && [ -z "$tag" ] \
    || hosting::die "--current reads the tag the portal runs — it takes neither --image nor --tag"
  hosting::probe output kubectl -n "$namespace" get deployment memex-portal-deployment \
      -o 'jsonpath={.spec.template.spec.containers[0].image}'
  case $? in
    2) hosting::die_refused "deployment/memex-portal-deployment in ${namespace}, whose image names the tag to migrate" ;;
    1) hosting::die "cannot read the image deployment/memex-portal-deployment runs in ${namespace} (${HOSTING_PROBE_ERR:-empty}) — there is no current tag to migrate" ;;
  esac
  running="${HOSTING_PROBE_OUT%%@*}"
  [[ "$running" == *:* ]] || hosting::die "the portal runs '${HOSTING_PROBE_OUT}', which names no tag — there is no current tag to migrate"
  tag="${running##*:}"
  hosting::log "current   ${tag} (the tag deployment/memex-portal-deployment runs)"
fi
# Exactly ONE of --image / --tag: two answers to "which build migrates" would be one too many.
if [ -n "$image" ] && [ -n "$tag" ]; then
  hosting::die "--image and --tag are both set — name the target ONCE (--image for a full reference, --tag to keep the release's own migration repository)"
fi
[ -n "$image" ] || [ -n "$tag" ] || hosting::die "missing required flag --image (or --tag)"
if [ -n "$image" ]; then
  # --release stays REQUIRED with --image: that is the plan's form, and the plan always knows it.
  hosting::need_flag release "$release"
  # A plain reference to the MIGRATION image, never the portal's: it lands in a Job spec, and a portal
  # image there would run the portal as a Job and report whatever that did as the migration.
  [[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9./_-]*/memex-migration:[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || hosting::die "--image '${image}' is not a plain memex-migration image reference (registry/…/memex-migration:tag) — refusing"
  tag="${image##*:}"
else
  [[ "$tag" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || hosting::die "--tag '${tag}' is not a plain image tag — refusing to interpolate it"
fi
[ -z "$release" ] || hosting::safe_name release "$release"
command -v jq >/dev/null 2>&1 \
  || hosting::die "jq is not installed in this image — the release's manifest and the Job's status are JSON"

# --release omitted (the interlock's form): read it off the portal Deployment helm owns. THREE answers
# (MeshWeaver#4722) — a Forbidden is not "no release", and neither answer may move an image.
if [ -z "$release" ]; then
  hosting::probe output kubectl -n "$namespace" get deployment memex-portal-deployment \
      -o 'jsonpath={.metadata.annotations.meta\.helm\.sh/release-name}'
  case $? in
    2) hosting::die_refused "deployment/memex-portal-deployment in ${namespace}, whose helm release owns the migration Job" ;;
    1) hosting::die "cannot establish the helm release of namespace ${namespace}: deployment/memex-portal-deployment carries no meta.helm.sh/release-name (${HOSTING_PROBE_ERR:-empty}). Without the release there is no migration Job to run, so the portal image must not move." ;;
  esac
  release="$HOSTING_PROBE_OUT"
  hosting::safe_name release "$release"
fi

# The Job's name: DNS-1123, at most 63 characters, one per tag.
suffix="$(printf '%s' "$tag" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')"
job="memex-migration-roll-${suffix}"
job="${job:0:63}"
while [[ "$job" == *- ]]; do job="${job%-}"; done

hosting::log "image     ${image:-<the migration repository of the release>:${tag}}"
hosting::log "release   ${release} → namespace ${namespace}"
hosting::log "job       ${job}"

# ── the release's own migration Job ─────────────────────────────────────────────────────────────
hosting::probe output helm get manifest "$release" --namespace "$namespace"
case $? in
  2) hosting::die_refused "release ${release}'s manifest in ${namespace} (helm reads it from the release Secrets), which holds the migration Job this step runs" ;;
  1) hosting::die "release ${release} in ${namespace} has no readable manifest — there is no migration Job to run, so the image must not move. helm said: ${HOSTING_PROBE_ERR}" ;;
esac
manifest="$HOSTING_PROBE_OUT"

# YAML → JSON through kubectl itself (the image carries no YAML parser), then pick the Job the chart
# labels as the migration.
# A here-string, never a pipe: a pipe runs hosting::probe in a subshell and HOSTING_PROBE_OUT dies with it.
hosting::probe output kubectl -n "$namespace" create --dry-run=client -o json -f - <<< "$manifest"
case $? in
  2) hosting::die_refused "the kinds in release ${release}'s manifest (a client-side dry run still resolves them against the API)" ;;
  1) hosting::die "release ${release}'s manifest could not be parsed: ${HOSTING_PROBE_ERR}" ;;
esac
rendered="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -c '
  (if .kind == "List" then .items[] else . end)
  | select(.kind == "Job" and .metadata.labels["app.kubernetes.io/component"] == "memex-migration")' | head -1)"
[ -n "$rendered" ] \
  || hosting::die "release ${release} in ${namespace} renders no migration Job (kind Job, label app.kubernetes.io/component=memex-migration) — nothing establishes the schema, so the image must not move"

# --tag: the target is the release's OWN migration repository at the new tag — the registry and
# path the install already migrates from, never one guessed from the portal's.
if [ -z "$image" ]; then
  current="$(printf '%s' "$rendered" | jq -r '[.spec.template.spec.containers[]?, .spec.template.spec.initContainers[]? | .image // "" | select(test("/memex-migration:"))] | first // ""')"
  [ -n "$current" ] \
    || hosting::die "release ${release}'s migration Job runs no memex-migration image — there is no repository to move to ${tag}, so the image must not move"
  image="${current%:*}:${tag}"
  [[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9./_-]*/memex-migration:[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || hosting::die "the release's migration image '${current}' does not yield a plain memex-migration reference at ${tag} — refusing"
  hosting::log "image     ${image} (the release's own migration repository, moved to ${tag})"
fi

# Rename, and move ONLY the migration containers. wait-for-postgres (busybox) and anything else keep
# their images; the rehearsal init container runs the migration image and must rehearse the SAME
# build it then executes.
#
# A migration container is one that RUNS a memex-migration image OR carries the chart's own
# migration container name (`memex-migration`, `memex-migration-rehearsal` — templates/memex-migration/
# job.yaml). The name matters for exactly one case, and it is the one that wedges an instance: a
# release whose `migration.image` was written as the PORTAL image. Measured on control 2026-10-06:
# hosting-deploy derived the migration image by substituting `memex-portal-ai`, which is a no-op on
# `memex-control`, so helm revision 4 rendered the Job as `memex-control:3.0.0-ci.10043` (its own Job
# `memex-migration-4` Failed) — and every later Roll refused here, because no container ran a
# memex-migration image any more. --image is already proven a memex-migration reference above, so
# moving the chart's named migration containers onto it runs the migration and nothing else; it is
# what puts such a release back on its feet, where refusing left only a hand-run helm upgrade.
body="$(printf '%s' "$rendered" | jq -c --arg name "$job" --arg img "$image" '
  def migration_container: (.image // "" | test("/memex-migration:"))
    or (.name // "" | test("^memex-migration(-rehearsal)?$"));
  def retarget: if migration_container then .image = $img else . end;
  .metadata = { name: $name, labels: (.metadata.labels // {}) }
  | .spec.template.spec.containers |= map(retarget)
  | if .spec.template.spec.initContainers then .spec.template.spec.initContainers |= map(retarget) else . end
  | del(.status)')"
moved="$(printf '%s' "$body" | jq --arg img "$image" '[.spec.template.spec.containers[]?, .spec.template.spec.initContainers[]? | select(.image == $img)] | length')"
[ "${moved:-0}" -ge 1 ] \
  || hosting::die "release ${release}'s migration Job runs no memex-migration image — nothing to retarget, refusing to run something else as the migration"
budget="$(printf '%s' "$body" | jq -r '.spec.activeDeadlineSeconds // 660')"
hosting::log "budget    ${budget}s (the Job's activeDeadlineSeconds) + ${grace}s to schedule and pull"

# ── PRESENT / ABSENT / REFUSED for this tag's Job ──────────────────────────────────────────────
job_state="" job_json=""
read_job_state() {
  hosting::probe any kubectl -n "$namespace" get job "$job" -o json
  case $? in
    2) hosting::die_refused "job/${job} in ${namespace}, which says whether this tag's migration already ran" ;;
    1) job_state="absent"; job_json=""; return 0 ;;
  esac
  job_json="$HOSTING_PROBE_OUT"
  job_state="$(printf '%s' "$HOSTING_PROBE_OUT" | jq -r '
    if (.status.succeeded // 0) >= 1 then "succeeded"
    elif ((.status.conditions // []) | any(.type == "Failed" and .status == "True")) then "failed"
    else "active" end')"
}

log_tail() {
  hosting::probe any kubectl -n "$namespace" logs "job/${job}" --all-containers --tail=20
  case $? in
    0) printf '%s' "$HOSTING_PROBE_OUT" ;;
    2) printf '(the log is not readable by this operator: %s)' "$HOSTING_PROBE_ERR" ;;
    *) printf '(no log: %s)' "$HOSTING_PROBE_ERR" ;;
  esac
}

# ── WHY a Job failed, from what this operator may read — never a Secret, never an env value ─────
# 🚨 MeshWeaver.Deploy#315. log_tail alone reads `kubectl logs job/<job>`, which lets kubectl pick ONE
# of the Job's pods. A Job that retried has several (backoffLimit), the pick may be one whose log is
# gone or never existed, and what came back was kubectl's own pod-selection notice on stderr —
# "(no log: Found 7 pods, using pod/…)" — quoted as the reason. The operator was told nothing.
#
# So a failed or overdue Job is DESCRIBED, from its status and its pods' status only:
#   1. the Job's condition (Failed / FailureTarget: reason and message) and its pod counts;
#   2. each of its pods — selected by the Job's own label, never by kubectl's pick — newest first:
#      phase, and every container's waiting / terminated reason, exit code and termination message;
#   3. the last events on those pods and on the Job (reason + message);
#   4. the log of the NEWEST FAILED pod itself, falling back to its previous container's log.
# Only `.status`, events and logs are read — never `.spec`, which is where env values and envFrom
# live. Every list is CAPPED (pods, events, log lines, message length), so a Job that retried
# a hundred times still yields a bounded message.
#
# 🚨 This is NARRATION. It never decides anything: every probe's three answers end in text, it never
# calls hosting::die and never exits, so the caller's verdict and exit code are exactly what they
# were without it.
diag_pods=8 diag_events=8 diag_lines=20 diag_chars=300
# The jq helpers every formatter below shares: one line, clipped.
diag_jq_defs='def clip: if length > $chars then .[0:$chars] + "…" else . end;
  def oneline: gsub("[\r\n]+"; " ⏎ ") | clip;
  def cstate:
    (if .state.waiting then "waiting \(.state.waiting.reason // "?")"
         + (if .state.waiting.message then ": \(.state.waiting.message | oneline)" else "" end)
     elif .state.terminated then "terminated \(.state.terminated.reason // "?") (exit \(.state.terminated.exitCode // "?")"
         + (if .state.terminated.signal then ", signal \(.state.terminated.signal)" else "" end) + ")"
         + (if .state.terminated.message then ": \(.state.terminated.message | oneline)" else "" end)
     elif .state.running then "running"
     else "no state reported" end)
    + (if .lastState.terminated then "; previously terminated \(.lastState.terminated.reason // "?") (exit \(.lastState.terminated.exitCode // "?"))" else "" end)
    + (if (.restartCount // 0) > 0 then "; restarts \(.restartCount)" else "" end);
  def statuses: ((.status.initContainerStatuses // []) | map(. + {kind: "init container"}))
              + ((.status.containerStatuses // []) | map(. + {kind: "container"}));
  def failed_container: (.state.terminated.exitCode // 0) != 0 or (.lastState.terminated.exitCode // 0) != 0;
  def failed_pod: .status.phase == "Failed" or any(statuses[]; failed_container);'

# The Job's pods by the Job's OWN label: `batch.kubernetes.io/job-name` (Kubernetes ≥ 1.27), then the
# legacy `job-name` every version sets. Sets diag_pods_json, or diag_pods_note saying why there is none.
diag_pods_json="" diag_pods_note=""
diag_read_pods() {
  local sel
  diag_pods_json="" diag_pods_note=""
  for sel in "batch.kubernetes.io/job-name=${job}" "job-name=${job}"; do
    hosting::probe any kubectl -n "$namespace" get pods -l "$sel" -o json
    case $? in
      2) diag_pods_note="  pods: not readable by this operator (${HOSTING_PROBE_ERR:-no reason given})"; return 0 ;;
      1) diag_pods_note="  pods: could not be listed (${HOSTING_PROBE_ERR:-no reason given})"; return 0 ;;
    esac
    if [ "$(jq '.items | length' <<< "$HOSTING_PROBE_OUT" 2>&1)" != "0" ]; then
      diag_pods_json="$HOSTING_PROBE_OUT"; return 0
    fi
  done
  diag_pods_note="  pods: none carry the label job-name=${job} (reaped, or never created)"
}

# Prints the CAUSE as its first line (one line, for the ERROR line the control plane quotes), then
# the description. Call it in a command substitution: it reads, it never writes and never exits.
failure_report() {
  local cause="" pod_cause="" newest="" names="[]" log="" out=""
  # 1. the Job: its condition and its counts (job_json is the last read_job_state's answer).
  if [ -n "$job_json" ]; then
    cause="$(jq -r --argjson chars "$diag_chars" "${diag_jq_defs}"'
      [.status.conditions[]? | select(.status == "True" and (.type == "Failed" or .type == "FailureTarget"))]
      | sort_by(.type != "Failed") | map("Job \(.type): \(.reason // "no reason") — \(.message // "no message" | oneline)") | first // empty' <<< "$job_json" 2>&1)"
    out+="$(jq -r --argjson chars "$diag_chars" "${diag_jq_defs}"'
      "  job/\(.metadata.name // "?"): active \(.status.active // 0), failed \(.status.failed // 0), succeeded \(.status.succeeded // 0)",
      (.status.conditions[]? | select(.status == "True")
       | "  job condition \(.type): \(.reason // "no reason") — \(.message // "no message" | oneline)")' <<< "$job_json" 2>&1)"$'\n'
  fi
  # 2. the pods, newest first, capped.
  diag_read_pods
  if [ -n "$diag_pods_json" ]; then
    out+="$(jq -r --argjson chars "$diag_chars" --argjson cap "$diag_pods" "${diag_jq_defs}"'
      .items | sort_by(.metadata.creationTimestamp // "") | reverse
      | (if length > $cap then "  (\(length) pods; the newest \($cap) shown)" else empty end),
        (.[0:$cap][]
         | "  pod \(.metadata.name): phase \(.status.phase // "?")"
             + (if .status.reason then " (\(.status.reason)" + (if .status.message then ": \(.status.message | oneline)" else "" end) + ")" else "" end),
           (.status.conditions[]? | select(.status == "False" and .reason != null and .type == "PodScheduled")
            | "    \(.type): \(.reason) — \(.message // "" | oneline)"),
           (statuses[] | "    \(.kind) \(.name): \(cstate)"))' <<< "$diag_pods_json" 2>&1)"$'\n'
    newest="$(jq -r --argjson chars "$diag_chars" "${diag_jq_defs}"'
      [.items[] | select(failed_pod)] | sort_by(.metadata.creationTimestamp // "") | last | .metadata.name // empty' <<< "$diag_pods_json" 2>&1)"
    pod_cause="$(jq -r --argjson chars "$diag_chars" "${diag_jq_defs}"'
      [.items[] | select(failed_pod)] | sort_by(.metadata.creationTimestamp // "") | last
      | if . == null then empty else
          .metadata.name as $pod | [statuses[] | select(failed_container or .state.waiting)] | first
          | if . == null then empty else "pod \($pod): \(.kind) \(.name) \(cstate)" end end' <<< "$diag_pods_json" 2>&1)"
    names="$(jq -c '[.items[].metadata.name]' <<< "$diag_pods_json" 2>&1)"
  else
    out+="${diag_pods_note}"$'\n'
  fi
  # 3. the last events on those pods and on the Job.
  hosting::probe any kubectl -n "$namespace" get events -o json
  case $? in
    0) out+="$(jq -r --argjson chars "$diag_chars" --argjson cap "$diag_events" --argjson pods "$names" --arg job "$job" "${diag_jq_defs}"'
         [.items[] | .involvedObject as $o
          | select(($o.kind == "Job" and $o.name == $job) or ($o.kind == "Pod" and ($pods | index([$o.name]) != null)))]
         | sort_by(.lastTimestamp // .eventTime // .metadata.creationTimestamp // "")
         | if length == 0 then "  events: none recorded for the Job or its pods (events expire after about an hour)"
           else (.[-$cap:][]
             | "  event \(.lastTimestamp // .eventTime // "?") \(.involvedObject.kind | ascii_downcase)/\(.involvedObject.name) \(.type // "") \(.reason // "?"): \(.message // "" | oneline)"
               + (if (.count // 1) > 1 then " (×\(.count))" else "" end)) end' <<< "$HOSTING_PROBE_OUT" 2>&1)"$'\n' ;;
    2) out+="  events: not readable by this operator (${HOSTING_PROBE_ERR:-no reason given})"$'\n' ;;
    *) out+="  events: could not be listed (${HOSTING_PROBE_ERR:-no reason given})"$'\n' ;;
  esac
  # 4. the newest failed pod's OWN log — its current container, else the previous one.
  if [ -n "$newest" ]; then
    hosting::probe output kubectl -n "$namespace" logs "$newest" --all-containers --tail="$diag_lines"
    case $? in
      0) log="$HOSTING_PROBE_OUT" ;;
      2) log="  (the log of pod/${newest} is not readable by this operator: ${HOSTING_PROBE_ERR})" ;;
      *) hosting::probe output kubectl -n "$namespace" logs "$newest" --all-containers --previous --tail="$diag_lines"
         case $? in
           0) log="$HOSTING_PROBE_OUT" ;;
           *) log="  (pod/${newest} has no readable log, current or previous: ${HOSTING_PROBE_ERR:-empty})" ;;
         esac ;;
    esac
    out+="  last lines of pod/${newest}:"$'\n'"${log}"
  else
    out+="  last lines (kubectl logs job/${job}):"$'\n'"$(log_tail)"
  fi
  # A newline inside the cause would push the rest of it off the quoted ERROR line.
  cause="${cause:-the Job carries no Failed condition}${pod_cause:+; ${pod_cause}}"
  printf '%s\n%s\n' "${cause//$'\n'/ }" "$out"
}

read_job_state
case "$job_state" in
  succeeded)
    if [ "$fresh" = 1 ]; then
      # The database this Job migrated is gone (renamed and kept by a reset): its success says
      # nothing about the empty one, so it is deleted and run again — never reported.
      hosting::log "migration ${job} SUCCEEDED for ${tag} against the database a reset replaced — deleting it and running it again (--fresh)"
      hosting::do kubectl -n "$namespace" delete job "$job" --wait=true >&2
    else
      hosting::log "migration ${job} already SUCCEEDED for ${tag} — not run again"
      hosting::say migration_job "$job"
      hosting::say migration completed
      exit 0
    fi ;;
  failed)
    hosting::log "migration ${job} FAILED before — deleting it and running it again"
    hosting::do kubectl -n "$namespace" delete job "$job" --wait=true >&2 ;;
  active)
    hosting::log "migration ${job} is already running — waiting on it" ;;
esac
if [ "$job_state" != "active" ]; then
  hosting::do kubectl -n "$namespace" create -f - <<< "$body" >&2 \
    || hosting::die "could not create ${job} in ${namespace}"
fi
hosting::say migration_job "$job"

if hosting::dry; then
  hosting::log "dry run: the Job was not created, so there is nothing to wait for"
  exit 0
fi

# ── wait: succeeded is the ONLY success ─────────────────────────────────────────────────────────
limit=$(( budget + grace )) waited=0
while :; do
  read_job_state
  case "$job_state" in
    succeeded) break ;;
    failed)
      report="$(failure_report)"
      hosting::die "migration ${job} FAILED for ${image} — the schema did not move, so the portal image must not either. Cause: ${report%%$'\n'*}
${report#*$'\n'}" ;;
    absent)
      hosting::die "migration ${job} disappeared while it was being waited on (deleted, or reaped) — nothing establishes that the schema moved, so the image must not" ;;
  esac
  if [ "$waited" -ge "$limit" ]; then
    report="$(failure_report)"
    hosting::die "migration ${job} has not completed after ${waited}s (its budget is ${budget}s) — refusing to move the image. State: ${report%%$'\n'*}
${report#*$'\n'}"
  fi
  sleep "$interval"
  waited=$(( waited + interval ))
  [ "$interval" -gt 0 ] || waited=$(( waited + 1 ))
done

hosting::log "migration ${job} SUCCEEDED after ~${waited}s"
done_line="$(log_tail | grep -m1 'Database migration completed' || true)"
[ -n "$done_line" ] && hosting::log "$done_line"
hosting::say migration completed

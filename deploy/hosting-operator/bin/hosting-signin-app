#!/usr/bin/env bash
# hosting-signin-app --name <id> --host <host> --vault <vault> --object <prefix>Authentication-Microsoft-ClientSecret
#                    [--client-id <Entra app id>] [--years 1]
# hosting-signin-app --per-machine <id> --domain <domain> --seal-to <base64 SPKI> --item <x> [--years 1]
#
# The SIGN-IN (Entra) app's client secret, in the vault, for the app the record names
# (MeshWeaver.Plugins#1719). Runbook step 1 registered the multi-tenant app, minted a secret and
# wrote it under <prefix>Authentication-Microsoft-ClientSecret by hand. What this step can and
# cannot do is decided by two facts and stated rather than papered over:
#
#   • A vault object that EXISTS is KEPT — never minted over, never rotated (the master-key rule).
#     With --client-id the app is then VERIFIED: its redirect URIs must carry
#     https://<host>/signin-microsoft, or every Microsoft sign-in fails with AADSTS50011 and nothing
#     names this step. Reading the app needs Graph `Application.Read.All`; an identity without it
#     cannot verify, SAYS so with the hand command, and does not fail the provision on a right it
#     was never granted (`signin_app_verify=unknown`).
#   • A vault object that is ABSENT and a record that NAMES the app → a NEW credential is ADDED to
#     the app (`az ad app credential reset --append`: existing credentials stay valid — this adds,
#     it never rotates) and written through --file. That needs Graph `Application.ReadWrite.OwnedBy`
#     on an app the operator identity OWNS (or `Application.ReadWrite.All`); without it the step is
#     RED with the exact hand commands.
#   • ABSENT and NO client id on the record → the app does not exist yet. Registering it is NOT
#     automated here: it needs the same Graph right AND writing the new client id back to the
#     git-owned record — RED with the runbook's exact commands and what to set on the record.
#
# PER-MACHINE MODE (--per-machine; Hosting/MacStudioFleet §2b.1 target 6, enrolment v2): an enrolling
# Mac gets its OWN Entra app, created here and owned by the operator identity — never a hand-added URI
# on a shared app (100-URI cap, no wildcards):
#   • found by its display name `MeshWeaver <id> (Mac)` among the apps this identity can see, else
#     CREATED (multi-tenant, like the shared app); exactly one may exist — two is a refusal;
#   • its web redirect URIs are the FIXED set — /signin-microsoft, /auth/callback/Microsoft and
#     /auth/ea/callback on https://<id>.net.<domain>, https://localhost:8443 and https://memex.localhost
#     (a Mac's portal answers on all three; the first Mac's owner met "localhost:8443/signin-microsoft is
#     not registered"). A found app keeps every URI it has and gains the missing ones; nothing on the
#     command line can add any other URI, so an approval cannot point an app at a foreign host;
#   • its service principal exists (created when absent);
#   • a NEW client secret is APPENDED (never a rotation) and SEALED inside this job to the Mac's
#     throw-away key (`::hosting:: sealed_item item=<x> …`); no vault object is written;
#   • the plain facts the enrolment code needs: `enrol_fact` clientId, tenant, redirectUris (comma-joined).
# It needs Graph `Application.ReadWrite.OwnedBy` (create + own) on the operator identity; a refusal is
# RED naming the right and the first line Graph answered. A secret that could not be sealed is DELETED
# from the app again before the step fails.
#
# 🚨 NEVER PRINTS THE SECRET. `az ad app credential reset` prints the minted secret on STDERR as
# well as in its output (measured, runbook step 1) — stderr is discarded, the value goes from az's
# stdout into a mode-600 temporary and reaches the vault through --file, never argv, never a log.
# shellcheck source=_common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_common.sh"
# shellcheck disable=SC2034  # read by hosting::die in _common.sh, which shellcheck does not follow here
HOSTING_CMD="hosting-signin-app"

name="" host="" vault="" object="" client_id="" years="1" per_machine="" domain="" seal_to="" item=""
# A flag given LAST with no value must not spin (see hosting-registry-coupon).
shift_value() { if [ $# -ge 2 ]; then shift_n=2; else shift_n=1; fi; }
while [ $# -gt 0 ]; do
  shift_n=1
  case "$1" in
    --name)        name="${2:-}";        shift_value "$@" ;;
    --host)        host="${2:-}";        shift_value "$@" ;;
    --vault)       vault="${2:-}";       shift_value "$@" ;;
    --object)      object="${2:-}";      shift_value "$@" ;;
    --client-id)   client_id="${2:-}";   shift_value "$@" ;;
    --years)       years="${2:-}";       shift_value "$@" ;;
    --per-machine) per_machine="${2:-}"; shift_value "$@" ;;
    --domain)      domain="${2:-}";      shift_value "$@" ;;
    --seal-to)     seal_to="${2:-}";     shift_value "$@" ;;
    --item)        item="${2:-}";        shift_value "$@" ;;
    *) hosting::die "unknown argument '$1'" ;;
  esac
  shift "$shift_n"
done

if [ -n "$per_machine" ] || [ -n "$domain" ] || [ -n "$seal_to" ] || [ -n "$item" ]; then
  # ── per-machine mode: create (or find) the Mac's own app, seal a new secret ──────────────────────
  hosting::need_flag per-machine "$per_machine"
  hosting::need_flag domain "$domain"
  hosting::need_flag seal-to "$seal_to"
  hosting::need_flag item "$item"
  [ -z "$name$host$vault$object$client_id" ] \
    || hosting::die "--per-machine creates the machine's OWN app and seals its secret — --name/--host/--vault/--object/--client-id belong to the shared-app mode and are refused beside it"
  [[ "$per_machine" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
    || hosting::die "per-machine '${per_machine}' is not a DNS label (lower-case letters, digits, '-') — it becomes <id>.net.<domain>"
  hosting::safe_host domain "$domain"
  [[ "$domain" == *.* ]] || hosting::die "domain '${domain}' is not a dotted domain name"
  hosting::safe_item "$item"
  [[ "$years" =~ ^[1-2]$ ]] || hosting::die "years '${years}' — a per-machine secret lives 1 or 2 years"
  umask 077
  work="$(mktemp -d)" || hosting::die "could not create a private working directory. Nothing was changed."
  trap 'hosting::on_exit; rm -rf "$work"' EXIT
  hosting::seal_key "$seal_to" "$work"

  display="MeshWeaver ${per_machine} (Mac)"
  uris=()
  for base in "https://${per_machine}.net.${domain}" "https://localhost:8443" "https://memex.localhost"; do
    for route in /signin-microsoft /auth/callback/Microsoft /auth/ea/callback; do uris+=("${base}${route}"); done
  done
  joined="$(IFS=,; printf '%s' "${uris[*]}")"
  right="the operator identity needs Microsoft Graph Application.ReadWrite.OwnedBy (application permission, admin-consented) to create and own a per-machine app"

  if hosting::dry; then
    hosting::log "(dry run) would find or create the app '${display}' with ${#uris[@]} redirect URIs (${joined}), ensure its service principal, append a ${years}-year client secret and seal it to the given RSA-${HOSTING_SEAL_BITS} key as item ${item} — nothing is changed"
    hosting::say signin_app dry-run
    hosting::enrol_fact redirectUris "$joined"
    exit 0
  fi

  hosting::step "Find or create the machine's sign-in app"
  hosting::probe any az account show --query tenantId -o tsv
  tenant="$HOSTING_PROBE_OUT"
  [[ "$tenant" =~ ^[0-9a-fA-F-]{36}$ ]] || hosting::die "could not read the tenant this identity signed in to (${HOSTING_PROBE_ERR:-no answer}). Nothing was changed."
  hosting::probe any az ad app list --display-name "$display" --query "[].appId" -o tsv; rc=$?
  [ "$rc" -eq 0 ] || hosting::die "Graph refused to list applications — ${right}. It answered: ${HOSTING_PROBE_ERR:-nothing}. Nothing was changed."
  found="$(grep -c . <<< "$HOSTING_PROBE_OUT" || true)"
  [ "$found" -le 1 ] || hosting::die "${found} applications are named '${display}' — exactly one may serve a machine. Delete the extra one(s) by hand (az ad app delete --id <appId>), then re-request. Nothing was changed."
  if [ "$found" -eq 1 ]; then
    app_id="$(head -n1 <<< "$HOSTING_PROBE_OUT")"
    outcome=found
  else
    hosting::probe any az ad app create --display-name "$display" --sign-in-audience AzureADMultipleOrgs \
      --web-redirect-uris "${uris[@]}" --query appId -o tsv; rc=$?
    [ "$rc" -eq 0 ] || hosting::die "Graph refused to create '${display}' — ${right}. It answered: ${HOSTING_PROBE_ERR:-nothing}. Nothing was changed."
    app_id="$HOSTING_PROBE_OUT"
    outcome=created
  fi
  [[ "$app_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
    || hosting::die "Graph answered '${app_id}' for '${display}', which is not an application (client) id — refusing to act on it"
  hosting::log "${outcome}   app ${app_id} '${display}'"

  hosting::step "Register the machine's redirect URIs"
  # A just-created application is not readable at once: Graph replicates a new object across its
  # directory replicas for seconds up to a couple of minutes, and a read that lands on a replica
  # that has not seen it answers "does not exist" although the create succeeded (measured
  # 2026-11-10, moench: created, then read back 'does not exist' at once). Wait that out — for a
  # CREATED app only, and only while the answer is "does not exist"; any other refusal is a right.
  hosting::probe any az ad app show --id "$app_id" --query 'web.redirectUris' -o tsv; rc=$?
  waited=0
  while [ "$rc" -ne 0 ] && [ "$outcome" = created ] && [ "$waited" -lt "${HOSTING_GRAPH_REPLICATION_WAIT:-180}" ] \
        && grep -qiE "does not exist|not found|Request_ResourceNotFound" <<< "${HOSTING_PROBE_ERR:-}"; do
    sleep 10; waited=$((waited + 10))
    hosting::probe any az ad app show --id "$app_id" --query 'web.redirectUris' -o tsv; rc=$?
  done
  [ "$waited" -eq 0 ] || hosting::log "waited    ${waited} s for Graph to replicate the new app ${app_id}"
  if [ "$rc" -ne 0 ] && [ "$waited" -ge "${HOSTING_GRAPH_REPLICATION_WAIT:-180}" ]; then
    hosting::die "app ${app_id} was created but Graph still answers 'does not exist' after ${waited} s of replication wait — not a missing right; re-run (the next run finds the app) or raise HOSTING_GRAPH_REPLICATION_WAIT. It answered: ${HOSTING_PROBE_ERR:-nothing}"
  fi
  [ "$rc" -eq 0 ] || hosting::die "could not read app ${app_id} back — ${right}. It answered: ${HOSTING_PROBE_ERR:-nothing}"
  have="$HOSTING_PROBE_OUT"
  missing=()
  for u in "${uris[@]}"; do grep -qxF -- "$u" <<< "$have" || missing+=("$u"); done
  if [ "${#missing[@]}" -gt 0 ]; then
    union=()
    while IFS= read -r u; do [ -n "$u" ] && union+=("$u"); done <<< "$have"
    union+=("${missing[@]}")
    hosting::probe any az ad app update --id "$app_id" --web-redirect-uris "${union[@]}"; rc=$?
    [ "$rc" -eq 0 ] || hosting::die "could not add ${#missing[@]} redirect URI(s) to app ${app_id} — ${right}. It answered: ${HOSTING_PROBE_ERR:-nothing}"
    hosting::probe any az ad app show --id "$app_id" --query 'web.redirectUris' -o tsv
    have="$HOSTING_PROBE_OUT"
    for u in "${uris[@]}"; do
      grep -qxF -- "$u" <<< "$have" || hosting::die "app ${app_id} still does not list ${u} after the update — refusing to hand out a secret for an app whose sign-in would fail with AADSTS50011"
    done
    hosting::log "added     ${#missing[@]} redirect URI(s) to app ${app_id} (read back)"
  else
    hosting::log "verified  app ${app_id} lists all ${#uris[@]} redirect URIs"
  fi

  hosting::step "Ensure the app's service principal"
  hosting::probe output az ad sp show --id "$app_id" --query id -o tsv; rc=$?
  case "$rc" in
    0) hosting::log "verified  the service principal of ${app_id}" ;;
    2) hosting::die "REFUSED, not absent: Graph would not show the service principal of ${app_id} — ${right}. It answered: ${HOSTING_PROBE_ERR}" ;;
    *) hosting::probe any az ad sp create --id "$app_id" --query id -o tsv; rc=$?
       waited=0  # the same replication lag as above can answer the create with "does not exist"
       while [ "$rc" -ne 0 ] && [ "$outcome" = created ] && [ "$waited" -lt "${HOSTING_GRAPH_REPLICATION_WAIT:-180}" ] \
             && grep -qiE "does not exist|not found|Request_ResourceNotFound" <<< "${HOSTING_PROBE_ERR:-}"; do
         sleep 10; waited=$((waited + 10))
         # A create is not a read: an earlier attempt may have LANDED although its answer was
         # "not found". Re-read first, and create again only while the principal is still absent.
         hosting::probe output az ad sp show --id "$app_id" --query id -o tsv
         case "$?" in
           0) rc=0; break ;;
           2) hosting::die "REFUSED, not absent: Graph would not show the service principal of ${app_id} — ${right}. It answered: ${HOSTING_PROBE_ERR}" ;;
         esac
         hosting::probe any az ad sp create --id "$app_id" --query id -o tsv; rc=$?
       done
       [ "$rc" -eq 0 ] || hosting::die "could not create the service principal of ${app_id} — ${right}. It answered: ${HOSTING_PROBE_ERR:-nothing}"
       hosting::log "created   the service principal of ${app_id}" ;;
  esac

  hosting::step "Add a client secret and seal it to the enrolling machine"
  label="enrol-${per_machine}-$(date -u +%Y%m%d%H%M%S)"
  # 🚨 stderr DISCARDED: az prints the minted secret there too. --append: nothing existing is rotated.
  if ! az ad app credential reset --id "$app_id" --append --display-name "$label" --years "$years" \
         --query password -o tsv > "$work/secret" 2>/dev/null; then
    rm -f "$work/secret"
    hosting::die "could not add a credential to app ${app_id} — ${right} (on an app it OWNS). Nothing was sealed."
  fi
  [ -s "$work/secret" ] || hosting::die "az ad app credential reset returned no password for app ${app_id} — nothing was sealed"
  # A trailing newline from -o tsv would become part of the secret the portal presents.
  printf '%s' "$(cat "$work/secret")" > "$work/secret"
  if ! hosting::seal_item "$item" "$work/secret" "$work"; then
    rm -f "$work/secret"
    key_id="$(az ad app credential list --id "$app_id" --query "[?displayName=='${label}'].keyId | [0]" -o tsv 2>/dev/null || true)"
    if [[ "$key_id" =~ ^[0-9a-fA-F-]{36}$ ]] && az ad app credential delete --id "$app_id" --key-id "$key_id" >/dev/null 2>&1; then
      hosting::die "the credential '${label}' could not be sealed (${HOSTING_SEAL_ERR}); it was DELETED from app ${app_id} again — nothing holds it"
    fi
    hosting::die "the credential '${label}' could not be sealed (${HOSTING_SEAL_ERR}) and could NOT be removed — delete it by hand: az ad app credential delete --id ${app_id} --key-id <the '${label}' credential>"
  fi
  rm -f "$work/secret"
  hosting::log "added     credential '${label}' to app ${app_id} (valid ${years} year(s)) → sealed as item ${item}; never shown, never stored"
  hosting::say signin_app "$outcome"
  hosting::say signin_secret sealed
  hosting::enrol_fact clientId "$app_id"
  hosting::enrol_fact tenant "$tenant"
  hosting::enrol_fact redirectUris "$joined"
  exit 0
fi
hosting::need_flag name "$name"
hosting::need_flag host "$host"
hosting::need_flag vault "$vault"
hosting::need_flag object "$object"
hosting::safe_name name "$name"
hosting::safe_host host "$host"
hosting::safe_name vault "$vault"
hosting::safe_name object "$object"
[[ "$years" =~ ^[1-9]$ ]] || hosting::die "years '${years}' is not a small whole number (1–9)"
if [ -n "$client_id" ] && ! [[ "$client_id" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
  hosting::die "client-id '${client_id}' is not an Entra application (client) id — refusing to interpolate it into a command"
fi

redirect="https://${host}/signin-microsoft"
display="${name} Portal (${host})"
register_by_hand="APP_ID=\$(az ad app create --display-name \"${display}\" --sign-in-audience AzureADMultipleOrgs --web-redirect-uris \"${redirect}\" --query appId -o tsv); az ad sp create --id \"\$APP_ID\" --output none; az ad app credential reset --id \"\$APP_ID\" --display-name ${name} --years ${years} --query password -o tsv > <file> 2>/dev/null; then paste it on the control instance's record page for this instance (Set Key Vault secrets…) as ${object} — never a hand-run vault command (policy secrets-write-only-entry), rm <file>, and set signIn.microsoftClientId: \"\$APP_ID\" on the record"
mint_by_hand="az ad app credential reset --id ${client_id:-<client id>} --append --display-name ${name} --years ${years} --query password -o tsv > <file> 2>/dev/null; then paste it on the control instance's record page for this instance (Set Key Vault secrets…) as ${object} — never a hand-run vault command (policy secrets-write-only-entry), and rm <file>"

kv_exists() {
  hosting::kv_exists "$vault" "$1"; local rc=$?
  [ "$rc" -eq 2 ] && hosting::die "could not LIST vault ${vault} to see whether $1 exists — refusing to read a refused listing as 'absent'. The identity needs \`list\` on ${vault}."
  return "$rc"
}

# verify_app — with a client id: the redirect must be on the app. Unreadable → said, not failed.
verify_app() {
  [ -n "$client_id" ] || { hosting::say signin_app_verify skipped; return 0; }
  hosting::step "Verify the sign-in app's redirect URI"
  local uris
  if ! uris="$(az ad app show --id "$client_id" --query 'web.redirectUris' -o tsv 2>/dev/null)"; then
    hosting::log "could not read app ${client_id} — the operator identity lacks Graph Application.Read.All. Verify by hand: az ad app show --id ${client_id} --query web.redirectUris (must list ${redirect})"
    hosting::say signin_app_verify unknown
    return 0
  fi
  if grep -qxF -- "$redirect" <<< "$uris"; then
    hosting::log "verified  app ${client_id} redirects to ${redirect}"
    hosting::say signin_app_verify true
    return 0
  fi
  hosting::die "app ${client_id} does not list ${redirect} among its web redirect URIs (it lists: $(printf '%s' "$uris" | tr '\n' ' ')) — every Microsoft sign-in would fail with AADSTS50011. Add it by hand: az ad app update --id ${client_id} --web-redirect-uris ${redirect} <existing URIs…>, then re-request."
}

if kv_exists "$object"; then
  hosting::log "keep    ${object} (exists — never minted over, never rotated)"
  hosting::say signin_secret kept
  if hosting::dry; then
    hosting::log "(dry run) would verify app ${client_id:-<none on the record>} lists ${redirect}"
    hosting::say signin_app_verify dry-run
    exit 0
  fi
  verify_app
  exit 0
fi

# ── absent ────────────────────────────────────────────────────────────────────────────────────
if [ -z "$client_id" ]; then
  hosting::die "${object} is absent from vault ${vault} and the record names no signIn.microsoftClientId — the sign-in app does not exist yet. Registering it is a hand step: it needs Graph Application.ReadWrite.OwnedBy (the operator identity holds no Graph right) AND the new client id written back to the git-owned record. Run: ${register_by_hand}; then re-request the action (this step then keeps the object and verifies the app)."
fi
if hosting::dry; then
  hosting::log "(dry run) ${object} is absent — a real run ADDS a credential to app ${client_id} (--append: nothing existing is rotated), stores it under ${object} through --file and verifies ${redirect}"
  hosting::say signin_secret would-create
  hosting::say signin_app_verify dry-run
  exit 0
fi

hosting::step "Add a client secret to the sign-in app"
umask 077
secret_file="$(mktemp)"
trap 'hosting::on_exit; rm -f "$secret_file"' EXIT
# 🚨 stderr DISCARDED: az prints the minted secret there too. --append: an existing credential
# stays valid — this adds a secret for THIS vault, it never rotates the app.
if ! az ad app credential reset --id "$client_id" --append --display-name "$name" --years "$years" \
       --query password -o tsv > "$secret_file" 2>/dev/null; then
  rm -f "$secret_file"
  hosting::die "could not add a credential to app ${client_id} — the operator identity needs Graph Application.ReadWrite.OwnedBy on an app it OWNS (or Application.ReadWrite.All); it holds neither today. Nothing was changed. Run by hand: ${mint_by_hand}; then re-request."
fi
[ -s "$secret_file" ] || { rm -f "$secret_file"; hosting::die "az ad app credential reset returned no password for app ${client_id} — nothing was stored"; }
# A trailing newline from -o tsv would become part of the secret the portal presents.
printf '%s' "$(cat "$secret_file")" > "$secret_file"
hosting::log "added     a credential '${name}' to app ${client_id} (valid ${years} year(s); the secret is not shown, here or anywhere)"

hosting::step "Store the client secret in Key Vault"
az keyvault secret set --vault-name "$vault" --name "$object" --file "$secret_file" --output none \
  || { rm -f "$secret_file"; hosting::die "the credential was added to app ${client_id} but could not be stored under ${object} in vault ${vault} — remove it (az ad app credential delete --id ${client_id} --key-id <the '${name}' credential>) or store it by hand, then re-request."; }
rm -f "$secret_file"
kv_exists "$object" || hosting::die "${object} was written to vault ${vault} but cannot be read back — refusing to report a secret the CSI driver will not find"
hosting::log "stored    ${object} in vault ${vault} (read back by id)"
expires="$(az ad app credential list --id "$client_id" --query "[?displayName=='${name}'].endDateTime | [0]" -o tsv 2>/dev/null || true)"
hosting::say signin_secret created
hosting::say signin_secret_expires "${expires:-unknown}"
verify_app
